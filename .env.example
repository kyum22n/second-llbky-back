# 로컬 개발용 환경변수 예시. 실제 값을 채운 뒤 .env 로 복사해서 사용하세요.
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않습니다.

## --- DB (docker-compose 로컬 Postgres 예시값) ---
# 호스트 포트는 5433 사용 (5432는 로컬에 Windows PostgreSQL 서비스가 이미 떠 있을 수 있어 충돌 방지)
DB_URL=jdbc:postgresql://localhost:5433/llbky
DB_USERNAME=llbky
DB_PASSWORD=llbky

## --- DB (Neon으로 전환 시 예시, sslmode=require 필수) ---
# DB_URL=jdbc:postgresql://<neon-host>/<db-name>?sslmode=require
# DB_USERNAME=<neon-user>
# DB_PASSWORD=<neon-password>

## --- OpenAI (Spring AI) ---
OPENAI_API_KEY=

## --- Naver API ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

## --- News API ---
NEWS_API_KEY=

## --- Google Custom Search API ---
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
